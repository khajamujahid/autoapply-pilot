# ApplyPilot configuration. Copy to .env and edit. Never commit .env.
# Public URL of the app (used for Google sign-in redirect)
BASE_URL=http://localhost:8077
PORT=8077

# Secrets: leave blank and they are generated once into ./data (keep ./data private & backed up).
# Set them explicitly if you run several containers or want to manage them yourself.
#   SECRET_KEY: any long random string (session cookies)
#   ENCRYPTION_KEY: Fernet key for API keys & site passwords:
#     python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=
ENCRYPTION_KEY=

# Database: SQLite in ./data by default. For Postgres:
# DATABASE_URL=postgresql+psycopg://applypilot:applypilot@localhost:5432/applypilot
DATABASE_URL=

# Sign in with Google (optional). See README "Google sign-in".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Let new people create accounts
ALLOW_SIGNUP=true
# Browser for auto-apply runs headless; set false to watch it work
HEADLESS=true
# Run the background worker inside the web process (true for local installs)
RUN_WORKER_IN_PROCESS=true

# Storage / logging / limits
# DATA_DIR=./data
LOG_LEVEL=INFO
# json (default) or text
LOG_FORMAT=json
MAX_UPLOAD_MB=10

# Optional extra job sources (free keys). Leave blank to skip.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
JSEARCH_API_KEY=
# Bundesagentur fuer Arbeit (Germany). Opt-in: no official API; its terms don't allow automated access.
ARBEITSAGENTUR=off
CAREER_SITES_BUDGET=240   # seconds per search for the 10k company career-site scan (hosted default 32)
