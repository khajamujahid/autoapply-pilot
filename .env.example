# OpenAI-compatible LLM (OpenAI, xAI Grok https://api.x.ai/v1, OpenRouter, local Ollama http://localhost:11434/v1 ...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
DRY_RUN=true            # true = fill + screenshot only, never submit
REQUIRE_REVIEW=true     # pause in REVIEW until you approve
MIN_MATCH_SCORE=0       # skip jobs below this score
DAILY_QUOTA=25          # max real submissions per 24h
HEADLESS=true
RUN_WORKER_IN_PROCESS=true  # false if you run `python -m app.worker` separately
